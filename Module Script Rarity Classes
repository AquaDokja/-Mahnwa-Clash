-- Define the classes available for each rarity
module.classes = {
    ["???"] = {"The Italiener", "The Gambler", "G to the G"} ,
    ["Mystical"] = {"The Goliath"} ,
    ["Legendary"] = {"Player" , "Shadow Monarch"} ,
    ["Epic"] = {"The Dancer" , "The Ultimate Hunter"} ,
    ["Rare"] = {"The Tiger" , "7 Star Hunter "} ,
    ["Uncommon"] = {"The Chauffeur" , "The Chairman"} ,
    ["Common"] = {"The Giant" , "The Healer" , "The Barrier" , "Old Man"}
}

-- Define the weights for each rarity (out of 1000)
module.rarities = {
    ["???"] = 1, -- 0.1%
    ["Mystical"] = 10, -- 1%
    ["Legendary"] = 25, -- 2.5%
    ["Epic"] = 50, -- 5%
    ["Rare"] = 100, -- 10%
    ["Uncommon"] = 264, -- 26.4%
    ["Common"] = 550, -- 55%
}

-- Function to choose a rarity based on weighted chances
module.chooseRarity = function()
    local randNum = math.random(1, 1000)
    local counter = 0
    
    -- Iterate through rarities and their weights
    for rarity, weight in module.rarities do
        counter += weight 
        -- If the random number falls within the current cumulative weight, return this rarity
        if randNum <= counter then
            return rarity
        end
    end
    -- Fallback in case something goes wrong (should ideally not be reached if weights sum to 1000)
    return "Common" 
end

-- Function to choose a class from the given rarity
module.chooseClasses = function(rarity)
    local classesInRarity = module.classes[rarity]
    if not classesInRarity or <#1340275029241495622>InRarity == 0 then
        warn("No classes found for rarity:", rarity)
        return nil -- Or return a default class
    end
    -- Select a random class from the list for the chosen rarity
    local chosenClass = classesInRarity[math.random(1, <#1340275029241495622>InRarity)]
    return chosenClass
end

return module
